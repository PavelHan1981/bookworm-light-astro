{
  /**
   * Cloudflare Workers — Static Assets deployment
   * Deploy:  npm run deploy:cf-workers
   * Preview: npm run preview:cf-workers
   */
  "name": "bookworm-light-astro",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // 必须与 astro.config.mjs 的 trailingSlash("never") 保持一致。
    // CF 默认 auto-trailing-slash 会给 index.html 补斜杠并 307,
    // 导致 canonical / sitemap / hreflang 全部指向重定向 URL。
    "html_handling": "drop-trailing-slash"
  }
}
