---
import Base from "@/layouts/Base.astro";
import Excerpts from "@/helpers/Excerpts";
---

<Base>
  <script is:inline>
    (function () {
      var savedLang = localStorage.getItem("preferred_lang");
      var userLang = (navigator.language || navigator.userLanguage || "").toLowerCase();
      var targetLang = savedLang || (userLang.startsWith("zh") ? "zh" : "en");
      window.location.replace("/" + targetLang);
    })();
  </script>
  <section class="section relative overflow-hidden flex flex-col justify-center min-h-[85vh]">
    <div class="container text-center">
      <Excerpts client:load />
    </div>
  </section>
</Base>
