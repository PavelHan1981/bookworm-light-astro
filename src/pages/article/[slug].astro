---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

export async function getStaticPaths() {
  const zhPosts = await getSinglePage("posts", "zh");

  return zhPosts
    .filter((post) => {
      const slug = post.data.slug || post.id.replace(/^zh\//, "").replace(/\.md$/, "");
      return !slug.startsWith("page/");
    })
    .map((post) => {
      const slug = post.data.slug || post.id.replace(/^zh\//, "").replace(/\.md$/, "");
      return {
        params: { slug },
        props: { slug },
      };
    });
}

const { slug } = Astro.props;
---

<Base title="Redirecting...">
  <script is:inline define:vars={{ slug }}>
    (function () {
      var savedLang = localStorage.getItem("preferred_lang");
      var userLang = (navigator.language || navigator.userLanguage || "").toLowerCase();
      var targetLang = savedLang || (userLang.startsWith("zh") ? "zh" : "en");
      window.location.replace("/" + targetLang + "/article/" + slug);
    })();
  </script>
  <div class="container py-12 text-center">
    <p>Redirecting to article...</p>
  </div>
</Base>
