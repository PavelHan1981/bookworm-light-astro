---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";
import config from "@/config/config.json";
import { slugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const posts = await getSinglePage("posts", "zh");

  return posts
    .filter((post) => {
      const slug = post.data.slug || post.id.replace(/^zh\//, "").replace(/\.md$/, "");
      return !slug.startsWith("page/");
    })
    .map((post) => {
      const slug = post.data.slug || post.id.replace(/^zh\//, "").replace(/\.md$/, "");
      return {
        params: { slug },
        props: { post },
      };
    });
}

const { post } = Astro.props;
const { title, meta_title, image, description, date, dateModified, authors, tags, faq } =
  post.data;
const slug = post.data.slug || post.id.replace(/^zh\//, "").replace(/\.md$/, "");

const allAuthors = await getSinglePage("authors");
const postAuthor =
  allAuthors.find((a) =>
    authors
      ?.map((author: string) => slugify(author))
      .includes(slugify(a.data.title))
  ) || allAuthors.find((a) => a.id === "pavel-han");

const authorSocial = postAuthor?.data.social;
const sameAs = authorSocial
  ? Object.values(authorSocial).filter(
      (v) => typeof v === "string" && v.startsWith("http")
    )
  : [];

if (postAuthor?.data.title === "Pavel Han" || postAuthor?.id === "pavel-han") {
  if (!sameAs.includes("WeChat Official Account: Pavel Han")) {
    sameAs.push("WeChat Official Account: Pavel Han");
  }
}

const pubDateStr = date ? new Date(date).toISOString() : undefined;
const modDateStr = (dateModified || date) ? new Date(dateModified || date).toISOString() : undefined;

const graphElements: any[] = [
  {
    "@type": "BlogPosting",
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${config.site.base_url}/zh/article/${slug}`,
    },
    headline: title,
    description: description || config.metadata.meta_description,
    image: image
      ? `${config.site.base_url}${image}`
      : `${config.site.base_url}${config.metadata.meta_image}`,
    author: {
      "@type": "Person",
      name: postAuthor?.data.title || "Pavel Han",
      sameAs: sameAs,
    },
    publisher: {
      "@type": "Organization",
      name: config.site.title,
      logo: {
        "@type": "ImageObject",
        url: `${config.site.base_url}${config.site.logo}`,
      },
    },
    datePublished: pubDateStr,
    dateModified: modDateStr,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "首页",
        item: `${config.site.base_url}/zh`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "文章",
        item: `${config.site.base_url}/zh/article`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: title,
        item: `${config.site.base_url}/zh/article/${slug}`,
      },
    ],
  },
];

if (faq && Array.isArray(faq) && faq.length > 0) {
  const faqListElement = faq
    .filter((item) => (item.q || item.question) && (item.a || item.answer))
    .map((item) => ({
      "@type": "Question",
      name: item.q || item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a || item.answer,
      },
    }));

  if (faqListElement.length > 0) {
    graphElements.push({
      "@type": "FAQPage",
      mainEntity: faqListElement,
    });
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graphElements,
};
const hasMath = Boolean(post.body && (/\$|\\\(|\\\[|\\begin/.test(post.body)));

---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang="zh-CN"
  ogType="article"
  publishedTime={pubDateStr}
  modifiedTime={modDateStr}
  author={postAuthor?.data.title || "Pavel Han"}
  tags={tags}
  hasMath={hasMath}
  jsonLd={JSON.stringify(jsonLd)}
  canonical={`${config.site.base_url}/zh/article/${slug}`}
>
  <link slot="head" rel="alternate" hreflang="zh" href={`${config.site.base_url}/zh/article/${slug}`} />
  <link slot="head" rel="alternate" hreflang="en" href={`${config.site.base_url}/en/article/${slug}`} />
  <link slot="head" rel="alternate" hreflang="x-default" href={`${config.site.base_url}/zh/article/${slug}`} />
  <PostSingle post={post} />
</Base>
