---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { markdownify } from "@/lib/utils/textConverter";
---

<footer class="section bg-dark">
  <div class="container text-center opacity-40 hover:opacity-100 transition-opacity duration-700">
    {/* footer menu */}
    <ul class="mb-8 space-x-4">
      {
        menu.footer.map((menu) => (
          <li class="inline-block">
            <a
              href={menu.url}
              class="p-4 text-white/75 hover:text-white transition-all"
            >
              {menu.name}
            </a>
          </li>
        ))
      }
    </ul>
    {/* copyright */}
    <p set:html={markdownify(config.params.copyright)} class="text-white/75 text-sm tracking-widest" />
  </div>
</footer>
