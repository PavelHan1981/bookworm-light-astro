---
import Logo from "@/components/Logo.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import menu from "@/config/menu.json";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith("/en");
const langPrefix = isEn ? "/en" : "/zh";

const localizedMain = main.map((item) => ({
  ...item,
  url: item.url === "/" ? `${langPrefix}` : `${langPrefix}${item.url}`,
}));
---

<header class="header pt-6">
  <nav class="navbar container flex items-center justify-between">
    <!-- Empty div to balance the centered menu if needed -->
    <div class="hidden md:block w-10"></div>

    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      id="show-button"
      for="nav-toggle"
      class="order-2 flex cursor-pointer items-center text-black md:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
    </label>
    <label
      id="hide-button"
      for="nav-toggle"
      class="order-2 hidden cursor-pointer items-center text-black"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full md:order-1 md:flex md:w-auto md:space-x-10 items-center justify-center"
    >
      {
        localizedMain.map((menu) => (
          <li class="nav-item">
            <a href={menu.url} class="nav-link block text-lg font-medium tracking-wide">
              {menu.name}
            </a>
          </li>
        ))
      }
    </ul>
    
    <div class="order-1 flex items-center space-x-3 md:order-2">
      <LanguageSwitcher />
      <a
        class="inline-block cursor-pointer p-2 text-xl text-dark transition hover:text-primary"
        href="/search"
        title="search"
        aria-label="search"
      >
        <IoSearch />
      </a>
    </div>
  </nav>
</header>
