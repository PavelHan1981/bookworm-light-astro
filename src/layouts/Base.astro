---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  jsonLd?: string;
  lang?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  hasMath?: boolean;
}

// distructure frontmatters
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  jsonLd,
  lang,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
  tags,
  hasMath = false,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID || config.google_analytics.id;

const computedLang =
  lang ?? (Astro.url.pathname.startsWith("/en") ? "en" : "zh-CN");
const ogLocale = computedLang.startsWith("en") ? "en_US" : "zh_CN";
const ogLocaleAlternate = computedLang.startsWith("en") ? "zh_CN" : "en_US";
---

<!doctype html>
<html lang={computedLang}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }

    <!-- google analytics -->
    {
      config.google_analytics.enable && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          />
          <script is:inline define:vars={{ id: gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", id);

            document.addEventListener("astro:page-load", () => {
              gtag("config", id, {
                page_path: window.location.pathname,
              });
            });
          </script>
        </>
      )
    }

    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css with preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- responsive meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- MathJax Configuration (Conditional) -->
    {
      hasMath && (
        <>
          <script is:inline>
            window.MathJax = &#123;
              tex: &#123;
                inlineMath: [['$', '$']],
                displayMath: [['$$', '$$']],
                processEscapes: true,
                processEnvironments: true
              &#125;,
              options: &#123;
                skipHtmlTags: ['script', 'noscript', 'style', 'textarea']
              &#125;,
              svg: &#123;
                fontCache: 'global'
              &#125;
            &#125;;

            document.addEventListener('astro:page-load', () => &#123;
              if (window.MathJax && window.MathJax.typesetPromise) &#123;
                window.MathJax.typesetPromise();
              &#125;
            &#125;);
          </script>
          <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
          
          <style is:global>
            /* Notion-style MathJax adjustments */
            
            /* 1. 区块公式样式 (Display Math) */
            mjx-container[display="true"] &#123;
              margin: 1.5rem 0 !important;
              overflow-x: auto !important;
              overflow-y: hidden !important;
              padding: 0.5rem 0 !important;
              display: block !important;
              width: 100%;
              text-align: center;
            &#125;
            mjx-container[display="true"] svg &#123;
              margin: 0 auto !important;
            &#125;

            /* 2. 内联公式样式 (Inline Math) */
            mjx-container:not([display="true"]) &#123;
              display: inline-block !important;
              vertical-align: middle;
              margin: 0 0.2em !important;
              padding: 0 !important;
            &#125;
            mjx-container:not([display="true"]) svg &#123;
              display: inline !important;
              margin: 0 !important;
              vertical-align: baseline !important;
            &#125;

            /* 防止 Shiki 代码块干扰 */
            pre:has(mjx-container), code:has(mjx-container) &#123;
              background: transparent !important;
              padding: 0 !important;
            &#125;
          </style>
        </>
      )
    }






    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link
      rel="canonical"
      href={canonical ? canonical : `${config.site.base_url}${Astro.url.pathname}`}
      item-prop="url"
    />

    <!-- rss feed discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${config.site.title} RSS Feed`}
      href={`${config.site.base_url}/rss.xml`}
    />

    <!-- head slot for extra link/meta tags like hreflang -->
    <slot name="head" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- og-locale -->
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />
    <meta property="og:type" content={ogType} />
    {
      ogType === "article" && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
          )}
          {author && <meta property="article:author" content={author} />}
          {tags &&
            tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta
      property="og:url"
      content={canonical ? canonical : `${config.site.base_url}${Astro.url.pathname}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
