---
import { getSinglePage } from "@/lib/contentParser.astro";
import { slugifyTaxonomy } from "@/lib/utils/textConverter";

// 按语言收集 taxonomy：zh 与 en 各自生成一套，避免两种语言的分类混在同一个页面里，
// 也避免英文独有的分类（Hardware、Cybersecurity…）因为只从中文文章收集而 404。
export const getTaxonomy = async (
  collection: any,
  name: string,
  lang: string = "zh",
) => {
  const singlePages = await getSinglePage(collection, lang);
  const taxonomyPages = singlePages.map((page: any) => page.data[name] ?? []);
  let taxonomies: string[] = [];
  for (let i = 0; i < taxonomyPages.length; i++) {
    const categoryArray = taxonomyPages[i];
    for (let j = 0; j < categoryArray.length; j++) {
      const slug = slugifyTaxonomy(categoryArray[j]);
      if (slug) taxonomies.push(slug);
    }
  }
  const taxonomy = [...new Set(taxonomies)];
  return taxonomy;
};

// get all taxonomies from frontmatter
export const getAllTaxonomy = async (
  collection: any,
  name: string,
  lang: string = "zh",
) => {
  const singlePages = await getSinglePage(collection, lang);
  const taxonomyPages = singlePages.map((page: any) => page.data[name] ?? []);
  let taxonomies: string[] = [];
  for (let i = 0; i < taxonomyPages.length; i++) {
    const categoryArray = taxonomyPages[i];
    for (let j = 0; j < categoryArray.length; j++) {
      taxonomies.push(slugifyTaxonomy(categoryArray[j]));
    }
  }
  return taxonomies;
};
---
