/**
 * htmlEntityDecoder
 */
export function htmlEntityDecoder(htmlWithEntities: string): string {
  if (!htmlWithEntities || typeof htmlWithEntities !== "string") return "";
  const entityList: Record<string, string> = {
    "&nbsp;": " ",
    "&lt;": "<",
    "&gt;": ">",
    "&amp;": "&",
    "&quot;": '"',
    "&#39;": "'",
  };
  try {
    return htmlWithEntities.replace(
      /(&amp;|&lt;|&gt;|&quot;|&#39;)/g,
      (entity: string) => entityList[entity] || entity
    );
  } catch (e) {
    return htmlWithEntities;
  }
}

/**
 * slugify
 */
export function slugify(content: string): string {
  if (!content || typeof content !== "string") return "";
  try {
    return content
      .toLowerCase()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");
  } catch (e) {
    return "";
  }
}

/**
 * markdownify
 */
export function markdownify(content: string, div?: boolean): string {
  if (!content || typeof content !== "string") return "";

  try {
    const html = content
      .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
      .replace(/\*(.*?)\*/g, "<em>$1</em>")
      .replace(/__(.*?)\__/g, "<strong>$1</strong>")
      .replace(/_(.*?)\_/g, "<em>$1</em>");

    return div ? `<div>${html}</div>` : html;
  } catch (e) {
    return content;
  }
}

/**
 * humanize
 */
export function humanize(content: string): string {
  if (!content || typeof content !== "string") return "";
  try {
    return content
      .replace(/^[\s_]+|[\s_]+$/g, "")
      .replace(/[_\s]+/g, " ")
      .replace(/[-\s]+/g, " ")
      .replace(/^[a-z]/, (m: string) => m.toUpperCase());
  } catch (e) {
    return content;
  }
}

/**
 * titleify
 */
export function titleify(content: string): string {
  if (!content || typeof content !== "string") return "";
  try {
    const humanized = humanize(content);
    return humanized
      .split(" ")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");
  } catch (e) {
    return content;
  }
}

/**
 * plainify
 */
export function plainify(content: string): string {
  if (!content || typeof content !== "string") return "";

  try {
    const filterMarkdown = content
      .replace(/^#+\s+/gm, "") // remove headers
      .replace(/\*\*(.*?)\*\*/g, "$1") // remove bold
      .replace(/\*(.*?)\*/g, "$1") // remove italic
      .replace(/\[(.*?)\]\(.*?\)/g, "$1") // remove links
      .replace(/!\[.*?\]\(.*?\)/g, "") // remove images
      .replace(/```[\s\S]*?```/g, "") // remove code blocks
      .replace(/`([^`]+)`/g, "$1") // remove inline code
      .replace(/<\/?[^>]+(>|$)/gm, ""); // remove HTML tags

    const filterSpaces = filterMarkdown.replace(/[\r\n]\s*[\r\n]/gm, " ").trim();
    return htmlEntityDecoder(filterSpaces);
  } catch (e) {
    return content;
  }
}
